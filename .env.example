# Copy to .env and adjust. See img-host/README.md for full config docs.

# Public base URL returned by the API (no trailing slash). Leave empty for relative paths.
IMG_HOST_BASE_URL=

# Host port to expose the server on
IMG_HOST_PORT=8080

# Auto-delete files after this long (duration string or bare seconds)
IMG_HOST_MAX_AGE=1h

# Per-upload size cap
IMG_HOST_MAX_FILE_SIZE=500MB

# Total storage cap; oldest files evicted when exceeded. 0 disables.
IMG_HOST_MAX_TOTAL_SIZE=0

# GHCR namespace used for the image tag when pushing via workflow
GHCR_NAMESPACE=you
